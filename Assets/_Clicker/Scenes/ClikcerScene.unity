  m_text: "\u041F\u043E\u0431\u0435\u0434\u0430!\r\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0448\u0430\u043D\u0441 \u043E\u0431\u0440\u0435\u0441\u0442\u0438
    \u043B\u0443\u0447\u0448\u0443\u044E \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C. \u041D\u043E \u0431\u0443\u0434\u044C\u0442\u0435
    \u043D\u0430\u0447\u0435\u043A\u0443: \u0430\u043D\u0433\u0435\u043B\u044B \u0432\u0441\u0451
    \u0443\u0437\u043D\u0430\u044E\u0442 \u2014 \u0438, \u0435\u0441\u043B\u0438
    \u043F\u043E\u0432\u0435\u0434\u0435\u0442\u0435 \u0441\u0435\u0431\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E,
    \u043E\u0442\u043F\u0440\u0430\u0432\u044F\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
    \u0432 \u0410\u0434."
